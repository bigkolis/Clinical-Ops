# Authentication accounts use strong server-side scrypt password hashes.
# Passwords themselves are not stored in the public repository.

# OPTIONAL: set this to 1 only if you intentionally want to replace the built-in accounts.
AUTH_USE_ENV=0
MILANA_LOGIN=
MILANA_PASSWORD=
MILANA_DISPLAY_NAME=Milana
STAFF_LOGIN=
STAFF_PASSWORD=
STAFF_DISPLAY_NAME=Clinical Ops Staff

# PRODUCTION SHARED WORKSPACE
# On ONREZA, attach the managed PostgreSQL integration and DATABASE_URL can be auto-injected.
# When present it enables shared snapshots, notes, overrides, login audit and a strong cookie-session signing key.
DATABASE_URL=

# OPTIONAL explicit cookie signing secret.
# If omitted while DATABASE_URL exists, the session key is derived server-side from DATABASE_URL.
SESSION_SECRET=

# Only set this for a local PostgreSQL instance without TLS.
DB_SSL=require
