# No environment variables are required for first deployment.
# Built-in Milana and Staff accounts use strong scrypt password hashes stored in code.
# Passwords themselves are not stored in the public repository.

# OPTIONAL: set this to 1 only if you intentionally want to replace the built-in accounts.
AUTH_USE_ENV=0

# OPTIONAL account overrides. Used only when AUTH_USE_ENV=1.
MILANA_LOGIN=
MILANA_PASSWORD=
MILANA_DISPLAY_NAME=Milana

STAFF_LOGIN=
STAFF_PASSWORD=
STAFF_DISPLAY_NAME=Clinical Ops Staff

# OPTIONAL: shared persistence for Staff/Milana notes + overrides only.
# Imported clinical spreadsheets remain browser-local.
DATABASE_URL=
