# Required for secure Vercel login
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# Milana personal/admin account
MILANA_LOGIN=milana@example.com
MILANA_PASSWORD=replace-me
MILANA_DISPLAY_NAME=Milana

# Shared Staff account
STAFF_LOGIN=clinical-ops
STAFF_PASSWORD=replace-me
STAFF_DISPLAY_NAME=Clinical Ops Staff

# Optional shared persistence for Staff/Milana notes + overrides only.
# Imported clinical spreadsheets remain browser-local.
DATABASE_URL=postgresql://user:password@host/database
