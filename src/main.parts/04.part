,actionCsv()));
  $$('[data-save]').forEach(b=>b.onclick=()=>saveNote(b.dataset.save));
  $('#loadLabels')?.addEventListener('click',()=>$('#filePicker').click()); $('#labelLayout')?.addEventListener('change',()=>{}); $('#printLabels')?.addEventListener('click',printLabels);
  $('#printReport')?.addEventListener('click',printReport); ['rVisit','rDates','rSite'].forEach(id=>$('#'+id)?.addEventListener('input',()=>{$('#reportText').textContent=`IMV #${$('#rVisit').value} · ${$('#rDates').value}`;}));
  $('#dataImport')?.addEventListener('click',()=>$('#filePicker').click());
  $$('[data-ai]').forEach(b=>b.onclick=()=>{$('#aiPrompt').value=b.dataset.ai;}); $('#prepareAi')?.addEventListener('click',prepareAi);
}

async function importFiles(files){ if(!files.length)return; for(const file of files){const rows=await readWorkbook(file); const names=Object.keys(rows[0]||{}); if(names.includes('Activity')&&names.includes('Actual visit date')) state.visitRows=rows; else if(names.includes('Randomization #')||names.some(n=>n.includes('DISP_REGIMEN'))) state.selectRows=rows; else if(names.some(n=>/Kit label/i.test(n))){state.labels=rows.map(r=>r['Kit label']).filter(Boolean).map(String);} } derive(); saveLocal(); renderPage(); }
async function readWorkbook(file){const buf=await file.arrayBuffer(); const wb=XLSX.read(buf,{type:'array',cellDates:true}); const ws=wb.Sheets[wb.SheetNames[0]]; return XLSX.utils.sheet_to_json(ws,{defval:null,raw:false,dateNF:'yyyy-mm-dd'});}
function cleanDate(v){if(!v)return null; const d=new Date(v); return Number.isNaN(d.getTime())?null:d;}
function regimen(row,no){const [a,b]=REGCOL[no]; return String(row?.[b]||row?.[a]||'').trim();}
function derive(){
  const site=String(state.site), select=state.selectRows.filter(r=>String(r['Site #']??'')===site || String(r['Столбец1']??'').startsWith(site+'-'));
  const byPatient=new Map(); select.forEach(r=>{const id=String(r['Столбец1']||r['Randomization #']||'').trim(); if(id)byPatient.set(id,r);});
  if(!byPatient.size && site==='10') Object.keys(BASELINE).forEach(id=>byPatient.set(id,{}));
  const visitMap=new Map(); state.visitRows.filter(r=>String(r['Site #']??'')===site).forEach(r=>visitMap.set(`${String(r['Screening #']||'').trim()}|${String(r.Activity||'').trim()}`,r));
  state.patients=[...byPatient].map(([id,row])=>{let prev=''; const visits=VISITS.map(([no,week,day,activity])=>{const vr=visitMap.get(`${id}|${activity}`)||{}; let rg=regimen(row,no); const n=noteFor(id,no); if(n.overrideRegimen)rg=n.overrideRegimen; const actual=cleanDate(n.overrideDate||vr['Actual visit date']), min=cleanDate(vr['Scheduled min']), max=cleanDate(vr['Scheduled max']); let window='Pending'; if(actual&&min&&max)window=actual<min?'Early':actual>max?'Late':'Within'; const before=prev||rg; const changed=Boolean((no===6||no===9)&&prev&&rg&&prev!==rg); if(rg)prev=rg; return {no,week,day,activity,actual,min,max,window,regimen:rg,before,changed};}); return {id,baseline:BASELINE[id]??'—',status:String(row['Status']||'Unknown'),visits,violations:visits.filter(v=>v.window==='Early'||v.window==='Late').length};}).sort((a,b)=>a.id.localeCompare(b.id));
  renderPage();
}
function demoData(){ if(state.selectRows.length||state.visitRows.length)return; const ids=Object.keys(BASELINE); state.selectRows=ids.map((id,i)=>({'Столбец1':id,'Site #':'10','Status':id==='10-19'?'Screened':'Included','V0_DISP_REGIMEN':i%4===0?'E4W':'E2W','V2_DISP_REGIMEN':i%4===0?'E4W':'E2W','V3_DISP_REGIMEN':i%4===0?'E4W':'E2W','V4_DISP_REGIMEN':i%4===0?'E4W':'E2W','V5_DISP_REGIMEN':i%4===0?'E4W':'E2W','V6_DISP_REGIMEN':i%5===0?'E4W':'E2W','V7_DISP_REGIMEN':i%5===0?'E4W':'E2W','V8_DISP_REGIMEN':i%5===0?'E4W':'E2W','V9_DISP_REGIMEN':i%6===0?'E4W':'E2W'}));
  const start=new Date('2025-11-06'); state.visitRows=[]; ids.forEach((id,pi)=>VISITS.forEach(([no,w,d,a])=>{if(no>6+(pi%5))return; const center=new Date(start); center.setDate(center.getDate()+d+pi*7); const min=new Date(center),max=new Date(center); min.setDate(min.getDate()-4);max.setDate(max.getDate()+4); const actual=new Date(center); if(pi===3&&no===6)actual.setDate(actual.getDate()+8); state.visitRows.push({'Site #':'10','Screening #':id,'Activity':a,'Scheduled min':dateKey(min),'Scheduled max':dateKey(max),'Actual visit date':dateKey(actual)});})); derive(); }

async function saveNote(ref){const [patient,visit]=ref.split('|'); const note=$(`[data-note="${ref}"]`)?.value||'', overrideDate=$(`[data-odate="${ref}"]`)?.value||'', overrideRegimen=$(`[data-oreg="${ref}"]`)?.value||''; state.notes[key(patient,visit)]={note,overrideDate,overrideRegimen}; saveLocal(); derive(); try{await fetch('/api/workspace',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({site:state.site,patient,visit:Number(visit),note,overrideDate,overrideRegimen,action:'Saved note / working override'})}); await syncWorkspace(false);}catch{} }
async function syncWorkspace(rerender=true){try{const r=await fetch(`/api/workspace?site=${encodeURIComponent(state.site)}`); if(!r.ok)return; const j=await r.json(); state.db=Boolean(j.enabled); (j.annotations||[]).forEach(a=>state.notes[`${a.site_id}|${a.patient_id}|${a.visit_no}`]={note:a.note_text||'',overrideDate:a.override_date?String(a.override_date).slice(0,10):'',overrideRegimen:a.override_regimen||''}); state.audit=j.audit||[]; saveLocal(); derive(); if(rerender)renderPage();}catch{state.db=false;}}
function saveLocal(){localStorage.setItem('clinical_ops_notes',JSON.stringify(state.notes));}
function loadLocal(){try{state.notes=JSON.parse(localStorage.getItem('clinical_ops_notes')||'{}');}catch{state.notes={};}}

function patientCsv(){const rows=[['Patient','Baseline','Status','Violations','W22 Actual','W22 Regimen','W40 Actual','W40 Regimen']]; state.patients.forEach(p=>rows.push([p.id,p.baseline,p.status,p.violations,dateKey(p.visits[5]?.actual),p.visits[5]?.regimen||'',dateKey(p.visits[8]?.actual),p.visits[8]?.regimen||''])); return rows;}
function actionCsv(){const rows=[['Patient','Visit','Week','Type','Detail']]; state.patients.forEach(p=>p.visits.forEach(v=>{if(['Early','Late'].includes(v.window))rows.push([p.id,v.no,v.week,'Window',`${v.window}: ${dateKey(v.actual)}`]); if((v.no===6||v.no===9)&&v.changed)rows.push([p.id,v.no,v.week,'Regimen',`${v.before} -> ${v.regimen}`]);})); return rows;}
function exportCSV(name,rows){const csv='\ufeff'+rows.map(r=>r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(';')).join('\r\n'); const a=document.createElement('a'); a.h