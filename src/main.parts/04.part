,actionCsv()));
  $$('[data-save]').forEach(b=>b.onclick=()=>saveNote(b.dataset.save));
  $('#loadLabels')?.addEventListener('click',()=>$('#labelFilePicker').click());
  ['labelLayout','batch','mfg','exp'].forEach(id=>$('#'+id)?.addEventListener(id==='labelLayout'?'change':'input',updateLabelMeta));
  $('#labelExportWord')?.addEventListener('click',()=>runLabelExport(exportLabelWord));
  $('#labelExportExcel')?.addEventListener('click',()=>runLabelExport(exportLabelExcel));
  $('#labelExportPdf')?.addEventListener('click',()=>runLabelExport(exportLabelPdf));
  $('#printLabels')?.addEventListener('click',()=>{updateLabelMeta();printLabels();});
  $('#loadReport')?.addEventListener('click',()=>$('#reportFilePicker').click());
  ['rVisit','rDates','rSite','rMon','rSummary'].forEach(id=>$('#'+id)?.addEventListener('input',updateReportState));
  $('#reportExportWord')?.addEventListener('click',()=>runReportExport(exportReportWord));
  $('#reportExportExcel')?.addEventListener('click',()=>runReportExport(exportReportExcel));
  $('#reportExportPdf')?.addEventListener('click',()=>runReportExport(exportReportPdf));
  $('#printReport')?.addEventListener('click',()=>{updateReportState();printReport();});
  $('#dataImport')?.addEventListener('click',()=>$('#filePicker').click());
  $$('[data-ai]').forEach(b=>b.onclick=()=>{$('#aiPrompt').value=b.dataset.ai;}); $('#prepareAi')?.addEventListener('click',prepareAi);
}

async function importFiles(files){
  if(!files.length)return;
  for(const file of files){
    const rows=await readWorkbook(file);
    const names=Object.keys(rows[0]||{});
    if(names.includes('Activity')&&names.includes('Actual visit date')) state.visitRows=rows;
    else if(names.includes('Randomization #')||names.some(n=>n.includes('DISP_REGIMEN'))) state.selectRows=rows;
  }
  refreshSiteSelector();
  derive();
  saveLocal();
  renderPage();
}
async function importLabelFiles(files){
  if(!files.length)return;
  try{
    const all=[]; const sources=[];
    for(const file of files){const result=await importLabelFile(file);all.push(...result.ids);sources.push(result.source);}
    state.labels=[...new Set(all.map(x=>String(x).trim()).filter(Boolean))];
    state.labelSource=sources.join(', ');
    renderPage();
    if(!state.labels.length){const s=$('#labelExportStatus');if(s)s.textContent='File loaded, but no label IDs were recognized.';}
  }catch(err){
    console.error('Label import failed',err);
    const msg=err?.message||'Could not import label file.';
    const s=$('#labelExportStatus');if(s)s.textContent=msg;else alert(msg);
  }finally{
    const p=$('#labelFilePicker');if(p)p.value='';
  }
}
async function importReportFiles(files){
  if(!files.length)return;
  try{
    const result=await importReportFile(files[0]);
    state.report={...state.report,...result,visit:result.visit||state.report.visit||'',dates:result.dates||state.report.dates||'',site:result.site||state.report.site||state.site||'',monitor:result.monitor||state.report.monitor||''};
    renderPage();
    const s=$('#reportExportStatus');if(s)s.textContent=`Imported ${result.sourceType}: ${result.source}`;
  }catch(err){
    console.error('Report import failed',err);
    const msg=err?.message||'Could not import report file.';
    const s=$('#reportExportStatus');if(s)s.textContent=msg;else alert(msg);
  }finally{
    const p=$('#reportFilePicker');if(p)p.value='';
  }
}
async function readWorkbook(file){const buf=await file.arrayBuffer(); const wb=XLSX.read(buf,{type:'array',cellDates:true}); const ws=wb.Sheets[wb.SheetNames[0]]; return XLSX.utils.sheet_to_json(ws,{defval:null,raw:false,dateNF:'yyyy-mm-dd'});}
function cleanDate(v){if(!v)return null; const d=new Date(v); return Number.isNaN(d.getTime())?null:d;}
function regimen(row,no){const [a,b]=REGCOL[no]; return String(row?.[b]||row?.[a]||'').trim();}
function selectPatientId(row){return String(row?.['Столбец1']??row?.['Screening #']??row?.['Randomization #']??'').trim();}
function visitPatientId(row){return String(row?.['Screening #']??row?.['Randomization #']??row?.['Столбец1']??'').trim();}
function derive(){
  discoverSites();
  const site=String(state.site||'');
  if(!site){state.patients=[];renderPage();return;}

  const select=state.selectRows.filter(r=>rowSite(r)===site);
  const visitsForSite=state.visitRows.filter(r=>rowSite(r)===site);
  const byPatient=new Map();
  select.forEach(r=>{const id=selectPatientId(r); if(id)byPatient.set(id,r);});
  visitsForSite.forEach(r=>{const id=visitPatientId(r); if(id&&!byPatient.has(id))byPatient.set(id,{});});

  const visitMap=new Map();
  visitsForSite.forEach(r=>{
    const id=visitPatientId(r), activity=String(r.Activity||'').trim();
    if(id&&activity)visitMap.set(`${id}|${activity}`,r);
  });

  state.patients=[...byPatient].map(([id,row])=>{
    let prev='';
    const visits=VISITS.map(([no,week,day,activity])=>{
      const vr=visitMap.get(`${id}|${activity}`)||{};
      let rg=regimen(row,no);
      const n=noteFor(id,no);
      if(n.overrideRegimen)rg=n.overrideRegimen;
      const actual=cleanDate(n.overrideDate||vr['Actual visit date']), min=cleanDate(vr['Scheduled min']), max=cleanDate(vr['Scheduled max']);
      let window='Pending';
      if(actual&&min&&max)window=actual<min?'Early':actual>max?'Late':'Within';
      const before=prev||rg;
      const changed=Boolean((no===6||no===9)&&prev&&rg&&prev!==rg);
      if(rg)prev=rg;
      return {no,week,day,activity,actual,min,max,window,regimen:rg,before,changed};
    });
    return {id,baseline:BASELINE[id]??'—',status:String(row['Status']||'Unknown'),visits,violations:visits.filter(v=>v.window==='Early'||v.window==='Late').length};
  }).sort((a,b)=>a.id.localeCompare(b.id,undefined,{numeric:true,sensitivity:'base'}));
  renderPage();
}

async function saveNote(ref){const [patient,visit]=ref.split('|'); const note=$(`[data-note="${ref}"]`)?.value||'', overrideDate=$(`[data-odate="${ref}"]`)?.value||'', overrideRegimen=$(`[data-oreg="${ref}"]`)?.value||''; state.notes[key(patient,visit)]={note,overrideDate,overrideRegimen}; saveLocal(); derive(); try{await authFetch('/api/workspace',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({site:state.site,patient,visit:Number(visit),note,overrideDate,overrideRegimen,action:'Saved note / working override'})}); await syncWorkspace(false);}catch{} }
async function syncWorkspace(rerender=true){if(!state.site)return;try{const r=await authFetch(`/api/workspace?site=${encodeURIComponent(state.site)}`); if(!r.ok)return; const j=await r.json(); state.db=Boolean(j.enabled); (j.annotations||[]).forEach(a=>state.notes[`${a.site_id}|${a.patient_id}|${a.visit_no}`]={note:a.note_text||'',overrideDate:a.override_date?String(a.override_date).slice(0,10):'',overrideRegimen:a.override_regimen||''}); state.audit=j.audit||[]; saveLocal(); derive(); if(rerender)renderPage();}catch{state.db=false;}}
function saveLocal(){localStorage.setItem('clinical_ops_notes',JSON.stringify(state.notes));}
function loadLocal(){try{state.notes=JSON.parse(localStorage.getItem('clinical_ops_notes')||'{}');}catch{state.notes={};}}

function patientCsv(){const rows=[['Patient','Baseline','Status','Violations','W22 Actual','W22 Regimen','W40 Actual','W40 Regimen']]; state.patients.forEach(p=>rows.push([p.id,p.baseline,p.status,p.violations,dateKey(p.visits[5]?.actual),p.visits[5]?.regimen||'',dateKey(p.visits[8]?.actual),p.visits[8]?.regimen||''])); return rows;}
function actionCsv(){const rows=[['Patient','Visit','Week','Type','Detail']]; state.patients.forEach(p=>p.visits.forEach(v=>{if(['Early','Late'].includes(v.window))rows.push([p.id,v.no,v.week,'Window',`${v.window}: ${dateKey(v.actual)}`]); if((v.no===6||v.no===9)&&v.changed)rows.push([p.id,v.no,v.week,'Regimen',`${v.before} -> ${v.regimen}`]);})); return rows;}
function exportCSV(name,rows){const csv='\ufeff'+rows.map(r=>r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(';')).join('\r\n'); const a=document.createElement('a'); a.h