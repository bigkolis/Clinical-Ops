ction class="grid label-grid"><div class="card"><div class="form-grid"><label>Layout<select id="labelLayout"><option value="20x40" ${m.layout==='20x40'?'selected':''}>20×40 mm · one ID</option><option value="80x60" ${m.layout==='80x60'?'selected':''}>80×60 mm · 10 IDs</option></select></label><label>Batch<input id="batch" value="${esc(m.batch)}"></label><label>Manufactured<input id="mfg" value="${esc(m.mfg)}"></label><label>Expiry<input id="exp" value="${esc(m.exp)}"></label></div><div class="label-source"><strong>${state.labelSource?esc(state.labelSource):'No label source loaded'}</strong><span>${state.labels.length?`${state.labels.length} IDs recognized`:'Import .docx, .xlsx or .xls'}</span></div><div class="label-actions label-export-actions"><button class="btn" id="labelExportWord">Word .docx</button><button class="btn" id="labelExportExcel">Excel .xlsx</button><button class="btn primary" id="labelExportPdf">PDF</button><button class="btn ghost" id="printLabels">Print</button></div><div id="labelExportStatus" class="label-export-status"></div></div><div class="card preview-card"><div class="card-head"><h2>Live preview</h2></div><div id="labelPreview">${labelPreview()}</div></div></section>`;}
function labelJob(){return {layout:state.labelMeta.layout,batch:state.labelMeta.batch,mfg:state.labelMeta.mfg,exp:state.labelMeta.exp,ids:[...state.labels]};}
function labelPreview(){const ids=state.labels.slice(0,10),m=state.labelMeta;if(!ids.length)return empty('Import a Word or Excel label list to preview.');return `<div class="label-paper"><div class="label-top"><strong>CL04041109 · Placebo</strong><span>Batch ${esc(m.batch)} · Mfg ${esc(m.mfg)} · Exp ${esc(m.exp)}</span></div><div class="label-id">${ids.map(x=>`<b>${esc(x)}</b>`).join('')}</div><small>Только для клинических исследований</small></div>`;}
function updateLabelMeta(){state.labelMeta={layout:$('#labelLayout')?.value||state.labelMeta.layout,batch:$('#batch')?.value||'',mfg:$('#mfg')?.value||'',exp:$('#exp')?.value||''};const p=$('#labelPreview');if(p)p.innerHTML=labelPreview();}
async function runLabelExport(fn){const status=$('#labelExportStatus');try{updateLabelMeta();if(!state.labels.length)throw new Error('Import a Word or Excel label list first.');if(status)status.textContent='Preparing file…';await fn(labelJob());if(status)status.textContent='Export ready.';}catch(err){console.error(err);if(status)status.textContent=err?.message||'Export failed.';}}

function reports(){return `${pageHead('REPORT BUILDER','Reports','Turn monitoring inputs into a clean printable brief instead of editing a giant Word file.','<button class="btn primary" id="printReport">Print / Save PDF</button>')}<section class="grid two"><div class="card"><div class="form-grid report"><label>Visit number<input id="rVisit" value="6"></label><label>Visit dates<input id="rDates" value="18–21.08.2026"></label><label>Site<input id="rSite" value="${esc(state.site||'10')}"></label><label>Monitor<input id="rMon" placeholder="Name"></label><label class="wide">Summary<textarea id="rSummary" rows="7" placeholder="Monitoring findings, documents, deviations, follow-up…"></textarea></label></div></div><div class="card report-preview"><span class="eyebrow">PREVIEW</span><h2>Interim Monitoring Visit</h2><p>Protocol CL04041383 · Site ${esc(state.site||'—')}</p><hr><h3>Visit details</h3><p id="reportText">IMV #6 · 18–21.08.2026</p><h3>Summary</h3><p class="muted">Enter findings on the left. Print to PDF when ready.</p></div></section>`;}

function data(){return `${pageHead('DATA LAYER','Source data','Import source exports locally. The app shows exactly what it recognized.','<button class="btn primary" id="dataImport">Import XLSX</button>')}<section class="grid two"><div class="card source-card"><span class="source-icon">S</span><div><strong>SelectControls</strong><p>Dosing regimen and patient status.</p><span class="source-state ${state.selectRows.length?'ok':''}">${state.selectRows.length?`${state.selectRows.length} rows loaded`:'Not loaded'}</span></div></div><div class="card source-card"><span class="source-icon">V</span><div><strong>Visits completion</strong><p>Scheduled min/max and Actual visit date.</p><span class="source-state ${state.visitRows.length?'ok':''}">${state.visitRows.length?`${state.visitRows.length} rows loaded`:'Not loaded'}</span></div></div></section><section class="card privacy-card"><h2>Privacy model</h2><p>The source workbooks are parsed by JavaScript running in this browser. Their bytes are not sent to the app server. If Postgres is enabled, only manual notes, overrides and audit events are synchronized.</p><div class="health">Shared workspace DB: <strong>${state.db?'Connected':'Local-only mode'}</strong></div></section>`;}

function ai(){if(state.user.role!=='milana')return overview(); return `${pageHead('MILANA · ADMIN','Semyon AI Operator','A supervisory layer over the same workspace. Staff keeps doing daily work; Milana gets an AI/operator console.','<span class="ai-pill">✦ Milana only</span>')}<section class="grid ai-grid"><div class="card"><div class="ai-context"><span>Site <b>${state.site||'—'}</b></span><span>Patients <b>${state.patients.length}</b></span><span>Exceptions <b>${state.patients.reduce((a,p)=>a+p.violations,0)}</b></span><span>DB <b>${state.db?'shared':'local'}</b></span></div><textarea id="aiPrompt" class="ai-prompt" placeholder="Например: проверь текущий сайт и покажи, какие отклонения ещё без причины…"></textarea><div class="chips"><button data-ai="Проверь все нарушения окон визитов и выдели те, где нет комментария.">Window review</button><button data-ai="Сравни режимы Week 22 и Week 40 и перечисли реальные изменения.">Regimen review</button><button data-ai="Подготовь краткий handoff по текущему сайту.">Handoff</button></div><button class="btn primary" id="prepareAi">Prepare task packet</button><pre id="aiPacket" class="ai-packet"></pre></div><div class="card"><span class="eyebrow">OPERATOR MANUAL</span><h2>How Semyon should work here</h2><div class="manual"><p><b>1.</b> Imported exports are source-of-truth.</p><p><b>2.</b> Manual corrections are explicit working overrides.</p><p><b>3.</b> W22/V6 and W40/V9 are regimen-change checkpoints.</p><p><b>4.</b> Never invent a deviation reason/number.</p><p><b>5.</b> Source XLSX remains browser-local.</p></div><p class="muted">A live ChatGPT App/MCP connection is the next integration layer. This console already prepares the structured project context it will need.</p></div></section>${auditView()}`;}
function auditView(){return `<section class="card"><div class="card-head"><h2>Audit trail</h2></div><div class="audit-list">${state.audit.map(a=>`<div><span>${fmt(a.created_at)}</span><strong>${esc(a.actor||'—')}</strong><p>${esc(a.action||'Update')} · ${esc(a.detail||'')}</p></div>`).join('')||empty('Shared audit appears here when DATABASE_URL is configured.')}</div></section>`;}

function bindPage(){
  $$('[data-goto]').forEach(x=>x.onclick=()=>{state.page=x.dataset.goto; $$('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.page===state.page)); renderPage();});
  $$('[data-open-patient]').forEach(x=>x.onclick=()=>{state.selected=x.dataset.openPatient; state.page='patients'; renderPage();});
  $$('tr[data-patient]').forEach(x=>x.onclick=()=>{state.selected=x.dataset.patient; renderPage();}); $$('[data-close-drawer]').forEach(x=>x.onclick=()=>{state.selected=null;renderPage();});
  const ps=$('#patientSearch'); if(ps)ps.oninput=e=>{state.search=e.target.value;renderPage();}; const po=$('#problemOnly'); if(po)po.onchange=e=>{state.filterProblems=e.target.checked;renderPage();};
  $('#exportPatients')?.addEventListener('click',()=>exportCSV('patients.csv',patientCsv())); $('#exportActions')?.addEventListener('click',()=>exportCSV('actions.csv'