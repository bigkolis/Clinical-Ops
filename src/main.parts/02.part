><span class="eyebrow">${kicker}</span><h1>${title}</h1><p>${sub}</p></div><div>${actions}</div></div>`;}
function overview(){
  const p=state.patients, violations=p.reduce((a,x)=>a+x.violations,0), w22=p.filter(x=>x.visits[5]?.actual).length, changes=p.filter(x=>x.visits[5]?.changed||x.visits[8]?.changed).length;
  return `${pageHead('STUDY WORKSPACE','Clinical operations, simplified.','One view for visits, regimen changes and exceptions.','<button class="btn primary" data-goto="actions">Open action center</button>')}
  <section class="metrics">${metric(p.length,'Patients','active in current site')}${metric(violations,'Window exceptions','need review','danger')}${metric(w22,'Week 22 complete','of '+p.length)}${metric(changes,'Regimen changes','W22 / W40')}</section>
  <section class="grid two"><div class="card"><div class="card-head"><div><span class="eyebrow">PRIORITY</span><h2>Action queue</h2></div><button class="link" data-goto="actions">View all →</button></div>${queue(5)}</div>
  <div class="card"><div class="card-head"><div><span class="eyebrow">REGIMEN</span><h2>Week 22 / Week 40</h2></div></div><div class="change-list">${p.slice(0,8).map(x=>changeRow(x)).join('')||empty('Import source files to begin.')}</div></div></section>
  <section class="card"><div class="card-head"><div><span class="eyebrow">PATIENTS</span><h2>Site ${state.site} at a glance</h2></div><button class="link" data-goto="patients">Open patient workspace →</button></div>${patientTable(p.slice(0,8))}</section>`;
}
function metric(n,label,sub,t=''){return `<div class="metric ${t}"><strong>${n}</strong><span>${label}</span><small>${sub}</small></div>`;}
function patients(){
  let rows=state.patients.filter(p=>!state.search||p.id.toLowerCase().includes(state.search.toLowerCase())); if(state.filterProblems) rows=rows.filter(p=>p.violations||p.visits.some(v=>v.changed));
  return `${pageHead('PATIENT WORKSPACE','Patients','Search, review and correct working data without touching the source export.','<button class="btn ghost" id="exportPatients">Export CSV</button>')}
  <div class="toolbar"><input id="patientSearch" placeholder="Search patient…" value="${esc(state.search)}"><label class="switch"><input id="problemOnly" type="checkbox" ${state.filterProblems?'checked':''}><span></span>Problems only</label></div>
  <section class="card flush">${patientTable(rows,true)}</section>${state.selected?patientDrawer(state.selected):''}`;
}
function patientTable(rows,clickable=false){return `<div class="table-wrap"><table><thead><tr><th>Patient</th><th>Baseline</th><th>Status</th><th>Week 22</th><th>W22 regimen</th><th>Week 40</th><th>W40 regimen</th><th>Exceptions</th></tr></thead><tbody>${rows.map(p=>`<tr ${clickable?`data-patient="${p.id}" class="clickable"`:''}><td><strong>${p.id}</strong></td><td>${p.baseline??'—'}</td><td><span class="status neutral">${esc(p.status||'Unknown')}</span></td><td>${fmt(p.visits[5]?.actual)}</td><td>${regChange(p.visits[5])}</td><td>${fmt(p.visits[8]?.actual)}</td><td>${regChange(p.visits[8])}</td><td><span class="status ${p.violations?'bad':'good'}">${p.violations}</span></td></tr>`).join('')||`<tr><td colspan="8">${empty('No patients to display.')}</td></tr>`}</tbody></table></div>`;}
function regChange(v){if(!v)return'—'; const a=esc(v.before||'—'), b=esc(v.regimen||'—'); return v.changed?`<span class="reg-change">${a} → ${b}</span>`:`<span>${b}</span>`;}
function patientDrawer(id){const p=state.patients.find(x=>x.id===id); if(!p)return''; return `<div class="drawer-backdrop" data-close-drawer></div><aside class="drawer"><div class="drawer-head"><div><span class="eyebrow">PATIENT</span><h2>${id}</h2><p>Baseline regimen ${p.baseline??'—'} · ${esc(p.status||'Unknown')}</p></div><button class="icon-btn" data-close-drawer>×</button></div><div class="timeline">${p.visits.map(v=>visitCard(p,v)).join('')}</div></aside>`;}
function visitCard(p,v){const n=noteFor(p.id,v.no); return `<article class="visit ${v.no===6||v.no===9?'key':''}"><div class="visit-dot"></div><div class="visit-body"><div class="visit-title"><div><strong>Visit ${v.no} · Week ${v.week}</strong><span>Day ${v.day}</span></div>${status(v.window)}</div><div class="visit-grid"><span>Actual<b>${fmt(v.actual)}</b></span><span>Window<b>${fmt(v.min)} – ${fmt(v.max)}</b></span><span>Regimen<b>${esc(v.before||'—')}${v.changed?` → ${esc(v.regimen||'—')}`:''}</b></span></div><div class="note-box"><textarea data-note="${p.id}|${v.no}" placeholder="Deviation reason / number or working note…">${esc(n.note||'')}</textarea><div class="override-row"><input type="date" data-odate="${p.id}|${v.no}" value="${esc(n.overrideDate||'')}"><select data-oreg="${p.id}|${v.no}"><option value="">No regimen override</option>${['E2W','E4W','E8W'].map(r=>`<option ${n.overrideRegimen===r?'selected':''}>${r}</option>`).join('')}</select><button class="btn small" data-save="${p.id}|${v.no}">Save</button></div></div></div></article>`;}
function status(w){const c=w==='Within'?'good':w==='Pending'?'neutral':'bad'; return `<span class="status ${c}">${w}</span>`;}
function actions(){return `${pageHead('ACTION CENTER','What needs attention','Exceptions and regimen-change events, without scanning 165 rows.','<button class="btn ghost" id="exportActions">Export CSV</button>')}<section class="card"><div class="action-list">${queue(999)}</div></section>`;}
function queue(limit){const items=[]; state.patients.forEach(p=>p.visits.forEach(v=>{if(v.window==='Early'||v.window==='Late')items.push({tone:'red',title:`${p.id} · Visit ${v.no}`,sub:`${v.window} · ${fmt(v.actual)} outside ${fmt(v.min)}–${fmt(v.max)}`,p:p.id}); if((v.no===6||v.no===9)&&v.changed)items.push({tone:'blue',title:`${p.id} · Week ${v.week}`,sub:`Regimen changed ${v.before||'—'} → ${v.regimen||'—'}`,p:p.id});})); return items.slice(0,limit).map(x=>`<button class="action-item" data-open-patient="${x.p}"><i class="${x.tone}"></i><div><strong>${esc(x.title)}</strong><span>${esc(x.sub)}</span></div><b>→</b></button>`).join('')||empty('No current exceptions. Import fresh exports when available.');}
function changeRow(p){const a=p.visits[5],b=p.visits[8]; return `<button class="change-row" data-open-patient="${p.id}"><strong>${p.id}</strong><span>W22 ${regChange(a)}</span><span>W40 ${regChange(b)}</span></button>`;}

function labels(){const m=state.labelMeta;return `${pageHead('LABEL STUDIO','Labels','Import Word or Excel and export print-ready Word, Excel or PDF.','<button class="btn ghost" id="loadLabels">Import Word / Excel</button>')}
  <se