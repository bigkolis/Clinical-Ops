ref=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download=name;a.click();URL.revokeObjectURL(a.href);}
function printLabels(){const {layout,batch,mfg,exp,ids}=labelJob();if(!ids.length){const s=$('#labelExportStatus');if(s)s.textContent='Import a Word or Excel label list first.';return;} const groups=layout==='80x60'?Array.from({length:Math.ceil(ids.length/10)},(_,i)=>ids.slice(i*10,i*10+10)):ids.map(x=>[x]); $('#printRoot').innerHTML=groups.map(g=>`<section class="print-label ${layout}"><strong>CL04041109 · Placebo</strong><span>Batch ${esc(batch)} · Mfg ${esc(mfg)} · Exp ${esc(exp)}</span><div>${g.map(x=>`<b>${esc(x)}</b>`).join('')}</div><small>Только для клинических исследований</small></section>`).join(''); document.body.classList.add('printing');setTimeout(()=>{window.print();document.body.classList.remove('printing');},60);}
function printReport(){const visit=$('#rVisit').value,dates=$('#rDates').value,site=$('#rSite').value,mon=$('#rMon').value,sum=$('#rSummary').value; $('#printRoot').innerHTML=`<article class="print-report"><h1>Interim Monitoring Visit Report</h1><p><b>Protocol:</b> CL04041383 &nbsp; <b>Site:</b> ${esc(site)}</p><p><b>IMV:</b> #${esc(visit)} &nbsp; <b>Dates:</b> ${esc(dates)}</p><p><b>Monitor:</b> ${esc(mon||'—')}</p><hr><h2>Summary</h2><p>${esc(sum||'No summary entered.').replace(/\n/g,'<br>')}</p></article>`;document.body.classList.add('printing');setTimeout(()=>{window.print();document.body.classList.remove('printing');},60);}
function prepareAi(){const prompt=$('#aiPrompt').value.trim(); const problems=[];state.patients.forEach(p=>p.visits.forEach(v=>{if(['Early','Late'].includes(v.window)||((v.no===6||v.no===9)&&v.changed))problems.push({patient:p.id,visit:v.no,week:v.week,window:v.window,actual:dateKey(v.actual),range:[dateKey(v.min),dateKey(v.max)],before:v.before,regimen:v.regimen,changed:v.changed,note:noteFor(p.id,v.no).note||''});})); const packet={task:prompt||'Review current workspace',study:'CL04041383',site:state.site,rules:['Imported exports are source-of-truth','Manual corrections are working overrides','Week 22/V6 and Week 40/V9 are regimen-change checkpoints','Do not invent deviation reasons/numbers'],summary:{patients:state.patients.length,windowExceptions:state.patients.reduce((a,p)=>a+p.violations,0),problems:problems.length},problems}; $('#aiPacket').textContent=JSON.stringify(packet,null,2);}
function empty(t){return `<div class="empty">${esc(t)}</div>`;}

boot();
