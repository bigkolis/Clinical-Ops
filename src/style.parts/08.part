
/* Mobile login density + form polish */
.staff-initials-field[hidden]{display:none!important}
@media(max-width:760px){
  .login-page{background:#eef2f7}
  .login-shell{background:#eef2f7}
  .login-art{
    min-height:0!important;
    justify-content:flex-start!important;
    padding:18px 22px 34px!important;
    background:radial-gradient(circle at 18% 8%,rgba(32,216,192,.13),transparent 28%),linear-gradient(145deg,#07152f,#102b49)!important;
  }
  .login-art>.brand,.login-art .brand-logo{margin-bottom:24px!important}
  .login-copy{max-width:390px!important}
  .login-copy .eyebrow{margin:0 0 8px!important;font-size:7px!important;letter-spacing:.18em!important}
  .login-copy h1{
    max-width:370px!important;
    margin:0 0 12px!important;
    font-size:clamp(31px,8.1vw,34px)!important;
    line-height:.99!important;
    letter-spacing:-.052em!important;
    text-wrap:balance;
  }
  .login-copy h1 span{display:inline;color:#8fa4c0}
  .login-copy p{
    max-width:365px!important;
    margin:0!important;
    font-size:11px!important;
    line-height:1.48!important;
    color:#a8b8cb!important;
  }
  .login-panel{
    position:relative;
    z-index:2;
    margin-top:-16px!important;
    padding:22px 14px calc(22px + env(safe-area-inset-bottom))!important;
    border-radius:24px 24px 0 0;
    background:#eef2f7!important;
  }
  .login-card{
    padding:20px 18px 18px!important;
    border-radius:20px!important;
    box-shadow:0 18px 50px rgba(16,35,59,.10)!important;
  }
  .login-card .kicker{font-size:7px!important;letter-spacing:.16em!important}
  .login-card h2{font-size:23px!important;line-height:1.05!important;margin:8px 0 7px!important}
  .login-card>p{margin:0 0 8px!important;font-size:9.5px!important;line-height:1.45!important}
  .login-card label{margin-top:10px!important;font-size:9px!important}
  .login-card label small{font-size:7px!important;font-weight:700!important;color:#8995a5!important}
  .login-card input{
    height:44px!important;
    margin-top:5px!important;
    border-radius:12px!important;
    padding:0 13px!important;
    font-size:16px!important;
  }
  .login-card input:focus{outline:none;border-color:#70a7e9;box-shadow:0 0 0 3px rgba(68,130,211,.12)}
  .login-card .btn{min-height:46px!important;margin-top:14px!important;border-radius:12px!important;font-size:11px!important}
  .login-error{min-height:0!important;margin-top:8px!important}
}
@media(max-width:430px){
  .login-art{padding-left:22px!important;padding-right:22px!important;padding-bottom:31px!important}
  .login-copy h1{max-width:355px!important;font-size:32px!important}
  .login-copy p{max-width:350px!important}
}
@media(max-width:390px){
  .login-art{padding:16px 18px 28px!important}
  .login-art>.brand,.login-art .brand-logo{margin-bottom:20px!important}
  .login-copy h1{font-size:29px!important;max-width:330px!important}
  .login-copy p{font-size:10.5px!important}
  .login-panel{padding-left:10px!important;padding-right:10px!important}
  .login-card{padding:18px 16px 16px!important}
}

/* Role-aware sign-in, access audit and physical label-sheet printing */
.login-role-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:16px 0 8px}.login-role-tabs button{appearance:none;border:1px solid #dbe3ee;background:#f7f9fc;border-radius:12px;padding:11px 12px;text-align:left;cursor:pointer;color:#5e6d81;transition:.15s ease}.login-role-tabs button b,.login-role-tabs button span{display:block}.login-role-tabs button b{font-size:10px;color:#22334a}.login-role-tabs button span{font-size:7px;line-height:1.35;margin-top:3px}.login-role-tabs button.active{background:#102b49;border-color:#102b49;box-shadow:0 7px 20px rgba(16,43,73,.16)}.login-role-tabs button.active b{color:#fff}.login-role-tabs button.active span{color:#aebfd2}.login-role-hint{font-size:7.5px;line-height:1.45;color:#7e8b9c;margin-bottom:8px;min-height:22px}.staff-initials-field[hidden],.raw-login-field[hidden]{display:none!important}.security-audit-card{margin:14px 32px 30px}.security-mode{font-size:7px;font-weight:850;color:#60728a;background:#f1f5f9;border-radius:999px;padding:6px 8px}.security-audit-list{display:grid;gap:1px}.security-event{display:grid;grid-template-columns:135px 150px 90px 1fr;gap:9px;align-items:center;padding:9px 0;border-bottom:1px solid #edf0f4;font-size:8px}.security-event span,.security-event small{color:#8793a3}.security-event b{font-size:7px;text-transform:uppercase;letter-spacing:.06em;color:#2c8b67}.security-event.fail b{color:#b95050}.security-event small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.security-event strong{color:#304159}
@media(max-width:760px){.login-role-tabs{margin-top:13px}.login-role-tabs button{padding:10px}.login-role-tabs button b{font-size:11px}.login-role-tabs button span{font-size:7px}.login-role-hint{font-size:8px;min-height:26px}.security-audit-card{margin:10px 14px 18px}.security-event{grid-template-columns:1fr auto;gap:4px 8px;padding:10px 0}.security-event span{grid-column:1}.security-event strong{grid-column:1}.security-event b{grid-column:2;grid-row:1/3;align-self:center}.security-event small{grid-column:1/-1;white-space:normal;font-size:7px}}
@media print{
  @page{size:A4 portrait;margin:0}
  body.printing{margin:0!important;padding:0!important;background:#fff!important}
  .printing #printRoot.label-sheet-print{display:flex!important;flex-wrap:wrap!important;align-content:flex-start!important;align-items:flex-start!important;gap:2mm!important;width:210mm!important;min-height:297mm!important;padding:7mm!important;box-sizing:border-box!important;background:#fff!important}
  .label-sheet-print .print-label,.label-sheet-print .custom-print{page-break-after:auto!important;break-after:auto!important;break-inside:avoid!important;page-break-inside:avoid!important;box-sizing:border-box!important;flex:0 0 auto!important;max-width:none!important;max-height:none!important;transform:none!important;margin:0!important;overflow:hidden!important}
  .label-sheet-print .print-label strong,.label-sheet-print .print-label span,.label-sheet-print .print-label b,.label-sheet-print .print-label small{max-width:100%;overflow:hidden;text-overflow:clip}
}
