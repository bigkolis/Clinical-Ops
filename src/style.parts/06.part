
/* Advanced labels, history and operator polish */
.label-advanced{grid-template-columns:repeat(2,minmax(0,1fr))}.label-advanced label{min-width:0}.version-actions{grid-template-columns:1fr 1fr auto auto auto!important}.version-panel{display:grid;gap:5px;margin-top:7px}.version-panel:empty{display:none}.version-panel>div{background:#f7f9fc;border:1px solid #e7ebf1;border-radius:8px;padding:7px;font-size:7px;color:#66758a}.version-panel b,.version-panel small{display:block}.version-panel small{margin-top:3px;white-space:normal;word-break:break-word;color:#8c97a5}.custom-print{padding:2mm;page-break-after:always;break-after:page}.custom-print>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1mm 3mm;margin:1mm 0}.custom-print b{display:block}.report-actions{display:flex;gap:7px;flex-wrap:wrap}.ai-buttons .btn{white-space:nowrap}
@media(max-width:650px){.label-advanced{grid-template-columns:1fr 1fr}.version-actions{grid-template-columns:1fr 1fr!important}.version-actions input,.version-actions select{grid-column:span 1}.version-actions .btn{width:100%}.report-actions{display:grid;grid-template-columns:1fr 1fr}.report-actions .btn{min-height:42px}.label-advanced input,.label-advanced select{min-height:40px}.ai-buttons{grid-template-columns:1fr!important}}
