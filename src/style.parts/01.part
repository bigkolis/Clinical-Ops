:root{--bg:#f4f6f9;--card:#fff;--ink:#16243a;--muted:#718096;--line:#e5eaf0;--nav:#0b1728;--blue:#3867d6;--blue2:#edf3ff;--green:#167b5b;--red:#b42318;--amber:#a05c00;--shadow:0 14px 40px rgba(22,36,58,.06)}*{box-sizing:border-box}html,body,#app{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg)}button,input,select,textarea{font:inherit}.shell{display:grid;grid-template-columns:230px 1fr;min-height:100vh}.sidebar{background:linear-gradient(180deg,#0b1728,#10243c);color:#fff;padding:22px 14px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:10px}.brand-mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#5a84ff,#35c2a1);display:grid;place-items:center;color:#fff;font-weight:900;font-size:11px}.brand strong,.brand small{display:block}.brand strong{font-size:13px}.brand small{font-size:8px;color:#8293a9;margin-top:2px;letter-spacing:.08em}.brand.side{padding:0 8px 24px}.sidebar nav{display:grid;gap:4px}.nav-item{border:0;background:transparent;color:#91a2b8;text-align:left;border-radius:11px;padding:10px 11px;display:flex;align-items:center;gap:11px;font-size:10px;font-weight:700;cursor:pointer}.nav-item>span{width:20px;height:20px;border-radius:7px;background:rgba(255,255,255,.05);display:grid;place-items:center;font-size:10px}.nav-item:hover,.nav-item.active{background:rgba(255,255,255,.08);color:#fff}.nav-rule{height:1px;background:rgba(255,255,255,.08);margin:12px 8px}.sidebar-foot{margin-top:auto}.privacy{display:flex;gap:9px;align-items:flex-start;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.035);border-radius:12px;padding:10px}.privacy i{width:7px;height:7px;border-radius:50%;background:#39c59c;margin-top:3px;box-shadow:0 0 0 4px rgba(57,197,156,.1)}.privacy strong,.privacy span{display:block}.privacy strong{font-size:8px}.privacy span{font-size:7px;color:#8395ab;margin-top:3px;line-height:1.4}.workspace{min-width:0}.topbar{height:64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:20}.topbar>div{display:flex;align-items:center;gap:10px}.study{font-size:8px;font-weight:850;color:#6f7e92;letter-spacing:.06em;text-transform:uppercase}.topbar select{height:32px;border:1px solid var(--line);border-radius:9px;padding:0 9px;background:#fff;font-size:9px}.top-actions{display:flex;align-items:center;gap:8px}.user{display:flex;align-items:center;gap:7px;border-left:1px solid var(--line);padding-left:10px}.user>span{width:30px;height:30px;border-radius:9px;background:#183b63;color:#fff;display:grid;place-items:center;font-size:8px;font-weight:900}.user strong,.user small{display:block}.user strong{font-size:9px}.user small{font-size:7px;color:#8692a2;margin-top:2px}.icon-btn{width:32px;height:32px;border:1px solid var(--line);background:#fff;border-radius:9px;color:#67758a;cursor:pointer}.btn{border:1px solid var(--line);background:#fff;color:#34465e;border-radius:10px;padding:8px 12px;font-size:9px;font-weight:800;cursor:pointer}.btn.primary{background:#183b63;border-color:#183b63;color:#fff}.btn.ghost{background:#f8fafc}.btn.small{padding:7px 10px}.btn.wide{width:100%}.link{border:0;background:transparent;color:#4169bd;font-size:8px;font-weight:800;cursor:pointer}.page-head{display:flex;align-items:flex-end;justify-content:space-between;padding:30px 32px 22px}.page-head h1{font-size:28px;margin:5px 0 5px;letter-spacing:-.035em}.page-head p{margin:0;color:var(--muted);font-size:10px}.eyebrow,.kicker{font-size:7px;font-weight:900;letter-spacing:.13em;color:#5574a0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:0 32px 14px}.metric{background:#fff;border:1px solid var(--line);border-radius:15px;padding:17px;box-shadow:var(--shadow)}.metric strong,.metric span,.metric small{display:block}.metric strong{font-size:27px;letter-spacing:-.04em}.metric span{font-size:9px;font-weight:850;margin-top:5px}.metric small{font-size:8px;color:#8a96a6;margin-top:4px}.metric.danger strong{color:var(--red)}.grid{display:grid;gap:14px;padding:0 32px 14px}.grid.two{grid-template-columns:1fr 1fr}.card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:18px}.card.flush{padding:0;overflow:hidden}.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.card-head h2{font-size:14px;margin:3px 0 0}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:9px}th{text-align:left;color:#7e8b9c;font-size:7px;text-transform:uppercase;letter-spacing:.07em;padding:11px 13px;border-bottom:1px solid var(--line);background:#fbfcfd}td{padding:11px 13px;border-bottom:1px solid #edf0f4;white-space:nowrap}tbody tr:last-child td{border-bottom:0}tr.clickable{cursor:pointer}tr.clickable:hover{background:#f8fbff}.status{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:7px;font-weight:900}.status.good{background:#e9f7f1;color:var(--green)}.status.bad{background:#fff0ee;color:var(--red)}.status.neutral{background:#f0f3f7;color:#68778a}.reg-change{display:inline-block;padding:4px 7px;border-radius:7px;background:#edf3ff;color:#315eaa;font-weight:850}.empty{padding:28px;text-align:center;color:#96a0ae;font-size:9px}.action-list{display:grid}.action-item{display:grid;grid-template-columns:8px 1fr auto;gap:11px;align-items:center;border:0;border-bottom:1px solid #edf0f4;background:#fff;padding:12px 2px;text-align:left;cursor:pointer}.action-item:last-child{border-bottom:0}.action-item i{width:7px;height:7px;border-radius:50%}.action-item i.red{background:#e45145}.action-item i.blue{background:#4e7de3}.action-item strong,.action-item span{display:block}.action-item strong{font-size:9px}.action-item span{font-size:8px;color:#7b8898;margin-top:3px}.action-item b{color:#8a96a6}.change-list{display:grid}.change-row{display:grid;grid-template-columns:70px 1fr 1fr;gap:10px;align-items:center;border:0;border-bottom:1px solid #edf0f4;background:#fff;padding:10px 0;text-align:left;font-size:8px;cursor:pointer}.change-row:last-child{border-bottom:0}.change-row span{color:#68778a}.toolbar{display:flex;gap:12px;align-items:center;padding:0 32px 14px}.toolbar input{width:260px;height:36px;border:1px solid var(--line);border-radius:10px;padding:0 11px;background:#fff}.switch{display:fl