 10px}.login-card .btn{margin-top:14px;transition:transform .08s ease,opacity .15s ease,filter .15s ease}.login-card .btn:active{transform:translateY(1px);filter:brightness(.94)}.login-card .btn:disabled{opacity:.62;cursor:wait}.login-error{color:var(--red);font-size:8px;margin-top:9px;min-height:12px}.preview-help{font-size:7px;color:#97a1ae;margin-top:16px}.preview-help code{background:#f2f4f7;padding:2px 4px;border-radius:4px}.printing #app{display:none!important}#printRoot{display:none}.printing #printRoot{display:block}.print-label{page-break-after:always;break-after:page;background:#fff;color:#000;border:.25mm solid #000;font-family:Arial,sans-serif;display:flex;flex-direction:column;overflow:hidden}.print-label.20x40{width:40mm;height:20mm;padding:1.2mm;font-size:2.4mm}.print-label.80x60{width:80mm;height:60mm;padding:3mm;font-size:3.2mm}.print-label span,.print-label small{display:block;margin-top:1mm}.print-label div{display:grid;grid-template-columns:1fr 1fr;gap:.5mm 3mm;margin:1mm 0}.print-label small{margin-top:auto;text-align:center}.print-report{padding:16mm;color:#111;font-family:Georgia,serif}.print-report h1{font-size:24pt}.print-report p{line-height:1.7}.print-report hr{border:0;border-top:1px solid #999}@media(max-width:1000px){.shell{grid-template-columns:72px 1fr}.brand.side div,.nav-item:not(.active){font-size:0}.nav-item{justify-content:center}.nav-item.active{font-size:0}.sidebar-foot{display:none}.grid.two,.label-grid,.ai-grid{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.login-shell{grid-template-columns:1fr}.login-art{min-height:340px}.page-head,.grid,.metrics,.toolbar{padding-left:18px;padding-right:18px}.privacy-card{margin-left:18px;margin-right:18px}}@media(max-width:650px){.topbar{padding:0 12px}.user div,.study{display:none}.metrics{grid-template-columns:1fr 1fr}.page-head{align-items:flex-start;gap:12px}.page-head h1{font-size:23px}.visit-grid,.override-row,.form-grid,.ai-context{grid-template-columns:1fr}.login-art{padding:28px}.login-copy h1{font-size:38px}.trust{display:none}}
