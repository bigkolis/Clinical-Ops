ex;align-items:center;gap:8px;font-size:8px;color:#66758a}.switch input{display:none}.switch span{width:28px;height:16px;background:#ccd4df;border-radius:999px;position:relative}.switch span:after{content:"";position:absolute;width:12px;height:12px;border-radius:50%;background:#fff;top:2px;left:2px;transition:.15s}.switch input:checked+span{background:#376bd4}.switch input:checked+span:after{left:14px}.drawer-backdrop{position:fixed;inset:0;background:rgba(9,20,35,.28);z-index:40}.drawer{position:fixed;right:0;top:0;bottom:0;width:min(620px,94vw);background:#fff;z-index:41;box-shadow:-30px 0 70px rgba(10,25,44,.15);overflow:auto}.drawer-head{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);padding:22px;display:flex;justify-content:space-between;align-items:flex-start;z-index:2}.drawer-head h2{font-size:24px;margin:4px 0}.drawer-head p{font-size:9px;color:#7d8998;margin:0}.timeline{padding:20px 24px}.visit{display:grid;grid-template-columns:18px 1fr;gap:12px;position:relative;padding-bottom:16px}.visit:before{content:"";position:absolute;left:6px;top:12px;bottom:-4px;width:1px;background:#e3e8ef}.visit:last-child:before{display:none}.visit-dot{width:13px;height:13px;border-radius:50%;border:3px solid #dce5f0;background:#fff;z-index:1;margin-top:2px}.visit.key .visit-dot{border-color:#6f94e4}.visit-body{border:1px solid var(--line);border-radius:13px;padding:13px}.visit.key .visit-body{background:#f8fbff;border-color:#d7e2f6}.visit-title{display:flex;justify-content:space-between;align-items:start}.visit-title strong,.visit-title span{display:block}.visit-title strong{font-size:10px}.visit-title span{font-size:8px;color:#8a96a6;margin-top:3px}.visit-grid{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:8px;margin-top:11px}.visit-grid span{background:#f7f9fb;border-radius:9px;padding:8px;color:#8994a3;font-size:7px}.visit-grid b{display:block;color:#304159;font-size:8px;margin-top:3px}.note-box{margin-top:9px}.note-box textarea{width:100%;m