
/* Brand system */
.brand-mark{background:transparent url('/brand/clinical-ops-mark.svg') center/contain no-repeat!important;color:transparent!important;font-size:0!important;border-radius:0!important;box-shadow:none!important;flex:0 0 auto}
.login-art>.brand{width:min(430px,88%);height:96px;background:url('/brand/clinical-ops-logo.svg') left center/contain no-repeat;gap:0}
.login-art>.brand>*{visibility:hidden}
.brand.side .brand-mark{width:42px;height:42px}
.brand.side strong{font-weight:850;letter-spacing:-.02em}
.brand.side small{color:#8ca0b9}
.brand-logo img{width:38px;height:38px;display:block;object-fit:contain;flex:0 0 auto}.brand-logo.side img{width:38px;height:38px}.top-selectors{min-width:0}.study-select{max-width:270px;font-weight:800;color:#20334d}.quick-actions{display:none}.site-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:10px}.site-card{position:relative;border:1px solid var(--line);background:#fbfcfe;border-radius:13px;padding:13px;text-align:left;cursor:pointer;display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:center;transition:.15s ease}.site-card:hover{border-color:#cbd8eb;background:#f7faff;transform:translateY(-1px)}.site-card strong{display:block;font-size:23px;margin-top:2px}.site-stats{display:grid;grid-template-columns:1fr 1fr;gap:5px;font-size:7px;color:#718096}.site-stats b{color:#31445d;font-size:9px}.bad-text,.bad-text b{color:var(--red)!important}.site-health{position:absolute;right:10px;top:10px;width:7px;height:7px;border-radius:50%}.site-health.good{background:var(--green)}.site-health.warn{background:#d08a1d}.site-health.bad{background:var(--red)}.metric.warn strong{color:#a46610}.status.warn{background:#fff5df;color:#976316}.action-item i.amber{background:#d89a2d}.deviation-box{margin-top:9px;border-top:1px solid #edf0f4;padding-top:9px}.deviation-box.needs-deviation{background:#fffaf5;border:1px solid #f3dec1;border-radius:10px;padding:10px}.deviation-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;margin-bottom:7px}.deviation-grid .wide{grid-column:1/-1}.deviation-grid label{font-size:7px;font-weight:850;color:#68778a}.deviation-grid input,.deviation-grid select{width:100%;height:32px;margin-top:4px;border:1px solid var(--line);border-radius:8px;padding:0 7px;background:#fff;font-size:8px}.edited-by{display:block;color:#8b97a6;margin-top:7px;font-size:7px}.source-summary{grid-template-columns:1fr 1fr}.import-list{display:grid;gap:9px}.import-card{display:grid;grid-template-columns:1fr auto;gap:12px;border:1px solid var(--line);border-radius:12px;padding:12px;background:#fbfcfe}.import-main strong,.import-main span,.import-main small{display:block}.import-main strong{font-size:10px}.import-main span{font-size:8px;color:#65758a;margin-top:3px}.import-main small{font-size:7px;color:#9aa4b1;margin-top:5px;line-height:1.5}.import-warnings{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.import-warnings span{font-size:7px;background:#fff2e8;color:#a05c00;border-radius:999px;padding:4px 7px}.import-controls{display:flex;align-items:center;gap:7px}.import-controls select{height:33px;border:1px solid var(--line);border-radius:8px;background:#fff;padding:0 7px;font-size:8px}.snapshot-actions,.ai-buttons{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.btn:disabled{opacity:.48;cursor:not-allowed}.page-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.topbar select{max-width:100%}
@media(max-width:1000px){.brand.side .brand-mark{width:38px;height:38px}.brand.side{justify-content:center;padding-left:0;padding-right:0}.study-select{max-width:210px}.site-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.deviation-grid{grid-template-columns:1fr 1fr}.deviation-grid .wide{grid-column:1/-1}.source-summary{grid-template-columns:1fr 1fr}}
@media(max-width:650px){body{padding-bottom:78px}.shell{display:block}.sidebar{position:fixed;left:0;right:0;top:auto;bottom:0;height:auto;z-index:80;padding:7px max(8px,env(safe-area-inset-right)) calc(7px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left));display:block;background:#0b1728}.brand.side,.sidebar-foot,.nav-rule{display:none}.sidebar nav{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}.sidebar nav::-webkit-scrollbar{display:none}.nav-item,.nav-item.active{min-width:64px;flex:1;padding:6px 4px;display:flex;flex-direction:column;justify-content:center;gap:3px;font-size:7px;text-align:center;border-radius:9px}.nav-item>span{width:24px;height:22px;font-size:11px}.workspace{min-height:100vh}.topbar{height:auto;min-height:66px;padding:9px 12px;align-items:stretch;gap:8px}.topbar>div{gap:6px}.top-selectors{display:grid!important;grid-template-columns:1fr 88px;flex:1}.study-select{max-width:none;width:100%;font-size:8px!important}.topbar select{height:38px}.top-actions .btn{display:none}.user{padding-left:7px}.user>span{width:34px;height:34px}.page-head{padding:19px 15px 13px;display:block}.page-head h1{font-size:24px}.page-head p{font-size:9px;line-height:1.5;margin-top:5px}.page-actions{margin-top:12px;justify-content:flex-start}.page-actions .btn{min-height:42px}.quick-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:0 15px 12px}.quick-actions button{border:1px solid var(--line);background:#fff;border-radius:12px;padding:9px 4px;color:#42556d;display:grid;gap:3px;place-items:center}.quick-actions b{font-size:14px}.quick-actions span{font-size:7px;font-weight:800}.metrics{padding:0 15px 12px;gap:8px}.metric{padding:13px;border-radius:13px}.metric strong{font-size:22px}.grid,.toolbar{padding-left:15px;padding-right:15px}.grid{gap:10px}.card{padding:14px;border-radius:14px}.site-grid{grid-template-columns:1fr}.site-card{min-height:80px}.source-summary{grid-template-columns:1fr}.import-card{grid-template-columns:1fr}.import-controls{display:grid;grid-template-columns:1fr auto}.import-controls select{width:100%;height:40px}.deviation-grid{grid-template-columns:1fr}.deviation-grid .wide{grid-column:auto}.deviation-grid input,.deviation-grid select{height:40px;font-size:10px}.override-row{grid-template-columns:1fr 1fr!important}.override-row .btn{height:40px}.drawer{width:100vw}.drawer-head{padding-top:calc(16px + env(safe-area-inset-top))}.timeline{padding:14px}.visit-body{padding:12px}.visit-grid{grid-template-columns:1fr 1fr 1fr!important}.visit-grid span{padding:7px 5px}.table-wrap{overflow:visible}table,thead,tbody,tr,th,td{display:block}thead{display:none}tbody{display:grid;gap:8px;padding:0}tr{border:1px solid var(--line);border-radius:12px;background:#fff;padding:10px}td{border:0;padding:4px 0;white-space:normal;display:flex;justify-content:space-between;gap:8px;font-size:9px}td:before{color:#8b97a6;font-size:7px;font-weight:800;text-transform:uppercase}td:nth-child(1):before{content:'Patient'}td:nth-child(2):before{content:'Baseline'}td:nth-child(3):before{content:'Status'}td:nth-child(4):before{content:'Week 22'}td:nth-child(5):before{content:'W22 regimen'}td:nth-child(6):before{content:'Week 40'}td:nth-child(7):before{content:'W40 regimen'}td:nth-child(8):before{content:'Exceptions'}.card.flush{background:transparent;border:0;box-shadow:none}.toolbar{display:grid;grid-template-columns:1fr}.toolbar input{width:100%;height:42px}.label-export-actions,.report-actions,.snapshot-actions,.ai-buttons{display:grid;grid-template-columns:1fr 1fr}.label-export-actions .btn,.report-actions .btn,.snapshot-actions .btn,.ai-buttons .btn{min-height:42px}.login-shell{display:block}.login-art{min-height:280px;padding:24px;background:radial-gradient(circle at 30% 10%,rgba(32,216,192,.14),transparent 30%),linear-gradient(145deg,#07152f,#102b49)}.login-panel{padding:18px}.login-card{padding:22px}.brand-logo img{width:42px;height:42px}}
